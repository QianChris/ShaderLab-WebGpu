{
  "name": "shaderlab-webgpu",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:plugins": "tsc -p public/plugins --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "node scripts/validate-config.mjs",
    "smoke": "node scripts/smoke-plugin-loader.mjs",
    "verify": "npm run build && npm run check:plugins && npm test && npm run validate && npm run smoke",
    "site": "npm run build && node scripts/build-site.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@webgpu/types": "^0.1.46",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@d5techs/d5-gaussian-splat-lib": "^1.0.19",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "bitecs": "^0.4.0",
    "codemirror": "^6.0.2",
    "es-module-lexer": "^2.3.1",
    "sucrase": "^3.35.1",
    "vue": "^3.5.40"
  }
}
